{
  "name": "@odysseythink/agent-core-shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared primitives extracted from agent-core",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": ["./src/*.ts", "./src/*/index.ts"]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@odysseythink/kosong": "workspace:^",
    "picomatch": "^4.0.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
