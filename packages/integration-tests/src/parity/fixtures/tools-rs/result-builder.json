{
  "version": 1,
  "cases": [
    {
      "name": "truncates long lines at default 500",
      "op": {
        "type": "build_result",
        "writes": [
          ""
        ],
        "maxLineLength": 500
      },
      "expected": {
        "result": {
          "output": "\u2026",
          "isError": false,
          "message": "ok"
        }
      }
    },
    {
      "name": "error marks is error",
      "op": {
        "type": "build_result",
        "writes": [
          "something went wrong"
        ],
        "maxLineLength": 500,
        "asError": true
      },
      "expected": {
        "result": {
          "output": "something went wrong",
          "isError": true,
          "message": "it broke"
        }
      }
    }
  ]
}