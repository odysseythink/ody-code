{
  "name": "@odysseythink/integration-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-package integration tests for agent-core subsystem extraction",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": ["./src/*.ts", "./src/*/index.ts"]
